# === DeepSeek ===
DEEPSEEK_API_KEY="你的DeepSeek API Key"
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL="deepseek-reasoner"

# === MiniMax ===
MINIMAX_API_KEY="你的MiniMax API Key"
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL="abab6.5s-chat"

# === Kimi (月之暗面) ===
KIMI_API_KEY="你的Kimi API Key"
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL="moonshot-v1-128k"

# === 搜索工具 ===
TAVILY_API_KEY=你的Tavily API Key
JINA_API_KEY=

# === Agent 分工配置（填写 deepseek / minimax / kimi）===
ANALYZER_PROVIDER=deepseek    # 市场分析专家：DeepSeek，负责在无URL时基于产品卖点推理受众
PROCESSOR_PROVIDER=kimi       # 数据处理器：Kimi 128k超长上下文，局得下全站抓取内容
SCORER_PROVIDER=deepseek      # 商机打分员：DeepSeek 逻辑推理最强，评分最准确
COPYWRITER_PROVIDER=minimax   # 文案专家：MiniMax 创意写作能力强，销售文案更生动

# === 性能配置 ===
RATE_LIMIT_RPM=20             # 批量模式每分钟最大调用次数，默认 20

# === 安全配置 ===
# 密码使用 bcrypt 哈希（内置随机盐），无需额外配置 PASSWORD_SALT
